{
  "name": "ranked-fitness",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "./node_modules/.bin/prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "npx prisma migrate dev --name init",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "build:web-admin": "cd apps/web-admin && npm run build"
  },
  "dependencies": {
    "@clerk/nextjs": "^4.31.8",
    "@prisma/client": "5.16.2",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "5.16.2",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/client": "5.16.2"
  },
