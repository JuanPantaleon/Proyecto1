# Web Admin (Next.js)
# Solo se exponen al cliente las variables con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_key_here"
# Se usa en el servidor (middleware de Clerk) para proteger rutas.
CLERK_SECRET_KEY="sk_test_your_key_here"
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# URL base de la API backend (sin /api al final). El frontend concatena rutas /api/v1/... sobre esta base.
NEXT_PUBLIC_API_URL="http://localhost:3000"