generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MuscleGroup {
  PECHO
  ESPALDA
  PIERNAS
  HOMBROS
  BRAZOS
  CORE
  CARDIO
  OTROS
}

enum ExerciseLevel {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

enum MetricType {
  REPS_WEIGHT
  TIME_ONLY
  REPS_ONLY
}

enum SetType {
  NORMAL
  FAILURE
  WARMUP
}

enum Role {
  USER
  TRAINER
  GYM_ADMIN
  SUPER_ADMIN
}

enum SetValidationStatus {
  APPROVED
  REQUIRES_VIDEO
  REJECTED
}

model User {
  id                String    @id @default(uuid())
  clerkId           String    @unique @map("clerk_id")
  email             String    @unique
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  imageUrl          String?   @map("image_url")
  currentWeightKg   Decimal   @db.Decimal(5,2) @default(0) @map("current_weight_kg")
  heightCm          Int       @default(0) @map("height_cm")
  streakDays        Int       @default(0) @map("streak_days")
  role              Role      @default(USER)
  gymId             String?   @map("gym_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  sessions          Session[]
  sets              Set[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Exercise {
  id              String      @id @default(uuid())
  name            String      @unique
  muscleGroup     MuscleGroup @map("muscle_group")
  level           ExerciseLevel @default(PRINCIPIANTE)
  metricType      MetricType  @default(REPS_WEIGHT) @map("metric_type")
  massValue       Int         @map("mass_value")
  demandValue     Int         @map("demand_value")
  complexityValue Int         @map("complexity_value")
  impactValue     Int         @map("impact_value")
  exerciseFactor  Decimal     @db.Decimal(4,2) @map("exercise_factor")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  sets            Set[]

  @@map("exercises")
}

model Session {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt         DateTime @map("started_at")
  endedAt           DateTime? @map("ended_at")
  estimatedCalories Int      @default(0) @map("estimated_calories")
  createdAt         DateTime @default(now()) @map("created_at")

  timerState        TimerState @default(STOPPED) @map("timer_state")
  timerStartedAt    DateTime? @map("timer_started_at")
  timerPausedAt     DateTime? @map("timer_paused_at")
  accumulatedTime   Int       @default(0) @map("accumulated_time")

  sets              Set[]
  restTimers        RestTimer[]

  @@map("sessions")
}

model RestTimer {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  setId        String?  @map("set_id")
  startedAt    DateTime @map("started_at")
  endedAt      DateTime? @map("ended_at")
  durationSec  Int      @default(0) @map("duration_sec")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("rest_timers")
}

enum TimerState {
  RUNNING
  PAUSED
  STOPPED
}

model Set {
  id                String   @id @default(uuid())
  sessionId         String   @map("session_id")
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId        String   @map("exercise_id")
  exercise          Exercise @relation(fields: [exerciseId], references: [id])
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id])
  weightKg          Decimal? @db.Decimal(6,2) @map("weight_kg")
  reps              Int?
  durationSec       Int?     @map("duration_sec")
  setType           SetType  @default(NORMAL) @map("set_type")
  variantBonus      Decimal  @db.Decimal(3,2) @default(1.00) @map("variant_bonus")
  penalty           Decimal  @db.Decimal(3,2) @default(1.00)
  isRecordPr        Boolean  @default(false) @map("is_record_pr")
  isgScore          Decimal  @db.Decimal(8,2) @map("isg_score")
  validationStatus  SetValidationStatus @default(APPROVED) @map("validation_status")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("sets")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
  @@index([userId, createdAt])
  @@index([entity, entityId])
}